    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL CHECK(LENGTH(\"name\") BETWEEN 1 AND 40), \"type\" INTEGER NOT NULL, \"icon_key\" TEXT NOT NULL, \"color_hex\" TEXT NOT NULL CHECK(\"color_hex\" LIKE '#%'), \"is_default\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_default\" IN (0, 1)), \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), \"sort_order\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "accounts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"accounts\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL CHECK(LENGTH(\"name\") BETWEEN 1 AND 40), \"type\" INTEGER NOT NULL, \"opening_balance_minor\" INTEGER NOT NULL DEFAULT 0, \"icon_key\" TEXT NOT NULL, \"color_hex\" TEXT NOT NULL CHECK(\"color_hex\" LIKE '#%'), \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), \"sort_order\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "transactions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"transactions\" (\"id\" TEXT NOT NULL, \"type\" INTEGER NOT NULL, \"amount_minor\" INTEGER NOT NULL CHECK(\"amount_minor\" BETWEEN 1 AND 99999999900), \"account_id\" TEXT NOT NULL REFERENCES accounts (id), \"to_account_id\" TEXT NULL REFERENCES accounts (id), \"category_id\" TEXT NULL REFERENCES categories (id), \"payment_mode\" INTEGER NOT NULL, \"note\" TEXT NULL CHECK(\"note\" IS NULL OR LENGTH(\"note\") <= 200), \"occurred_at\" INTEGER NOT NULL, \"receipt_path\" TEXT NULL, \"recurring_rule_id\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, PRIMARY KEY (\"id\"), CHECK ((type = 2 AND to_account_id IS NOT NULL AND category_id IS NULL AND to_account_id <> account_id) OR (type IN (0, 1) AND category_id IS NOT NULL AND to_account_id IS NULL)));"
        }
      ]
