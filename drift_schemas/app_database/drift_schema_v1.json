          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"accounts\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL CHECK(LENGTH(\"name\") BETWEEN 1 AND 40), \"type\" INTEGER NOT NULL, \"opening_balance_minor\" INTEGER NOT NULL DEFAULT 0, \"icon_key\" TEXT NOT NULL, \"color_hex\" TEXT NOT NULL CHECK(\"color_hex\" LIKE '#%'), \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), \"sort_order\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
