<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen widget, hidden mode: lock on without "Show data on widget",
     or before onboarding (feature 008 FR-047). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:importantForAccessibility="no"
        android:src="@mipmap/ic_launcher" />

    <TextView
        android:id="@+id/widget_open_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="@string/widget_open"
        android:textColor="@color/widget_on_surface"
        android:textSize="16sp" />
</LinearLayout>
