-- Restorable settings only; device state (including this counter) never counts.
CREATE TRIGGER bk_settings_ins AFTER INSERT ON settings
WHEN (NEW."key" IN ('locale', 'currencyCode', 'firstDayOfWeek', 'dateFormat', 'themeMode', 'selectedTheme', 'fontSize', 'enabledModules', 'moduleOrder', 'notificationsEnabled', 'budgetAlertsEnabled', 'habitRemindersEnabled', 'dailySummaryTime', 'homeComingSoonDismissed') OR NEW."key" LIKE 'module.%')
BEGIN
  INSERT INTO settings ("key", value, updated_at)
    VALUES ('dataChangeCounter', '1', CAST(strftime('%s', 'now') AS INTEGER) * 1000)
    ON CONFLICT ("key") DO UPDATE SET value = CAST(value AS INTEGER) + 1;
END;

CREATE TRIGGER bk_settings_upd AFTER UPDATE ON settings
WHEN (NEW."key" IN ('locale', 'currencyCode', 'firstDayOfWeek', 'dateFormat', 'themeMode', 'selectedTheme', 'fontSize', 'enabledModules', 'moduleOrder', 'notificationsEnabled', 'budgetAlertsEnabled', 'habitRemindersEnabled', 'dailySummaryTime', 'homeComingSoonDismissed') OR NEW."key" LIKE 'module.%') AND NEW.value IS NOT OLD.value
BEGIN
  INSERT INTO settings ("key", value, updated_at)
    VALUES ('dataChangeCounter', '1', CAST(strftime('%s', 'now') AS INTEGER) * 1000)
    ON CONFLICT ("key") DO UPDATE SET value = CAST(value AS INTEGER) + 1;
END;

CREATE TRIGGER bk_settings_del AFTER DELETE ON settings
WHEN (OLD."key" IN ('locale', 'currencyCode', 'firstDayOfWeek', 'dateFormat', 'themeMode', 'selectedTheme', 'fontSize', 'enabledModules', 'moduleOrder', 'notificationsEnabled', 'budgetAlertsEnabled', 'habitRemindersEnabled', 'dailySummaryTime', 'homeComingSoonDismissed') OR OLD."key" LIKE 'module.%')
BEGIN
  INSERT INTO settings ("key", value, updated_at)
    VALUES ('dataChangeCounter', '1', CAST(strftime('%s', 'now') AS INTEGER) * 1000)
    ON CONFLICT ("key") DO UPDATE SET value = CAST(value AS INTEGER) + 1;
END;
