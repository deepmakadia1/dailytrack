-- Change-counter triggers (feature 010 research R5, data-model §2).
-- GENERATED from BackupSection.tables and BackupSettingsPolicy.restorableKeys;
-- test/core/database/change_counter_triggers_test.dart checks they match.
-- Each one raises settings.dataChangeCounter, so "changed since the last
-- backup" sees writes from every isolate, app open or not. A new module
-- that joins backup adds its tables' triggers here in its own migration.
import '../../../features/expense/data/tables/accounts_table.dart';
import '../../../features/expense/data/tables/categories_table.dart';
import '../../../features/expense/data/tables/transactions_table.dart';
import '../../../features/expense/data/tables/budgets_table.dart';
import '../../../features/expense/data/tables/recurring_rules_table.dart';
import '../../../features/habit/data/tables/habits_table.dart';
import '../../../features/habit/data/tables/habit_schedules_table.dart';
import '../../../features/habit/data/tables/habit_entries_table.dart';
import 'settings_table.dart';

CREATE TRIGGER bk_accounts_ins AFTER INSERT ON accounts BEGIN
  INSERT INTO settings ("key", value, updated_at)
    VALUES ('dataChangeCounter', '1', CAST(strftime('%s', 'now') AS INTEGER) * 1000)
    ON CONFLICT ("key") DO UPDATE SET value = CAST(value AS INTEGER) + 1;
END;

CREATE TRIGGER bk_accounts_upd AFTER UPDATE ON accounts BEGIN
  INSERT INTO settings ("key", value, updated_at)
    VALUES ('dataChangeCounter', '1', CAST(strftime('%s', 'now') AS INTEGER) * 1000)
    ON CONFLICT ("key") DO UPDATE SET value = CAST(value AS INTEGER) + 1;
END;

CREATE TRIGGER bk_accounts_del AFTER DELETE ON accounts BEGIN
  INSERT INTO settings ("key", value, updated_at)
    VALUES ('dataChangeCounter', '1', CAST(strftime('%s', 'now') AS INTEGER) * 1000)
    ON CONFLICT ("key") DO UPDATE SET value = CAST(value AS INTEGER) + 1;
END;

